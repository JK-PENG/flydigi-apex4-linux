"""Present a Flydigi Apex 4 to games as a DualSense, with real gyro.

Buttons and sticks come from the pad's ordinary evdev node; the IMU comes from
its vendor HID interface, which no kernel driver decodes. Both are relayed into
a virtual DualSense on /dev/uhid, where hid-playstation picks it up -- so a game
sees a PS5 pad with working motion, no Steam Input in the path.

The DualSense report units are not free parameters: hid-playstation normalises
sensors using the calibration feature report the device serves. This program
parses that blob exactly as the kernel does and derives the conversion from it,
rather than hard-coding a constant that a different blob would silently break.

  --dump     decode and print, create no device (start here)
  --calib    print what the served calibration implies, and exit

Uses flydigi/{uhid,ds5,ds5_usb}.py from openflydigi (MIT, Mikalai Kaliaha);
those carry an inputtino attribution of their own, see NOTICE-openflydigi.
"""
import argparse, os, select, signal, struct, sys, time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from apex4ds5 import (
    config, forceadapt, generic_trigger, legacy, padin, relay_lock,
    trigger_identity, trigger_state,
    trigger_translation,
)
from apex4ds5._ds5 import ds5, ds5_usb, uhid

DS_GYRO_RES_PER_DEG_S = 1024
DS_ACC_RES_PER_G = 8192

# Axis order and signs, pad frame -> DualSense frame.
#
# SDL hands a real DualSense's sensor axes to games in the order the hardware
# reports them, with no reordering or sign flips, so the DualSense frame is the
# one SDL documents: +X right, +Y up (a pad at rest reads +1 g on Y), +Z toward
# the player. The Apex 4 lying flat face up reads its gravity on Z, so its Z is
# the "up" axis and belongs in the DualSense's Y.
#
# What is NOT settled: the two remaining signs. Those follow from which physical
# side the pad was resting on in the calibration poses, and that rests on pose
# labels rather than on anything measured -- so they are options here, to be
# fixed by a guided tilt test rather than asserted.



def parse_map(spec, names):
    """"-x,z,y" -> [(index, sign), ...] over `names`."""
    out = []
    for token in spec.split(","):
        token = token.strip()
        sign = -1.0 if token.startswith("-") else 1.0
        key = token.lstrip("+-")
        if key not in names:
            raise SystemExit("unknown axis %r, expected one of %s" % (key, ", ".join(names)))
        out.append((names.index(key), sign))
    if len(out) != 3:
        raise SystemExit("axis map needs exactly three entries, got %r" % spec)
    return out


def parse_paddle_bits(spec):
    """Parse the measured vendor paddle-bit mask as an M1..M4 permutation."""
    values = spec.split(",") if isinstance(spec, str) else list(spec)
    try:
        bits = tuple(int(value) for value in values)
    except (TypeError, ValueError):
        raise SystemExit("paddle_bits must be four bit numbers, got %r" % spec)
    if len(bits) != 4 or set(bits) != {2, 3, 4, 5}:
        raise SystemExit("paddle_bits must be a permutation of 2,3,4,5, got %r"
                         % (spec,))
    return bits


def calibration_blob():
    return neutral_calibration(ds5_usb.FEATURE_REPORTS[0x05])


def calibration_factors():
    """Per-axis (raw per deg/s) and (raw per g, bias), read off the served blob.

    Mirrors ds_get_calibration_data(): the kernel indexes from buf[1] because
    buf[0] is the report id, and the blob here is stored without it.
    """
    blob = calibration_blob()

    def s16(i):
        return struct.unpack_from("<h", blob, i)[0]

    gyro_bias = (s16(0), s16(2), s16(4))
    gyro_plus = (s16(6), s16(10), s16(14))
    gyro_minus = (s16(8), s16(12), s16(16))
    speed_2x = s16(18) + s16(20)
    gyro = []
    for i in range(3):
        denom = abs(gyro_plus[i] - gyro_bias[i]) + abs(gyro_minus[i] - gyro_bias[i])
        # deg/s = raw * (speed_2x * RES / denom) / RES  =>  raw = deg/s * denom / speed_2x
        gyro.append(denom / speed_2x if speed_2x else 0.0)

    accel = []
    for i in range(3):
        plus, minus = s16(22 + i * 4), s16(24 + i * 4)
        range_2g = plus - minus
        bias = plus - range_2g // 2
        accel.append((range_2g / 2.0, bias))
    return gyro, accel


# Touchpad geometry as SDL reads it off a real DualSense.
TOUCHPAD_W, TOUCHPAD_H = 1920, 1080
TOUCH_POINT_OFFSET = 33          # first touch point in the input report
PADDLE_TARGETS = ("tp-left", "tp-right", "l3", "r3",
                  "paddle-left", "paddle-right", "fn1", "fn2", "none")
EDGE_ONLY_TARGETS = ("paddle-left", "paddle-right", "fn1", "fn2")

# A DualSense Edge is a DualSense with a different product id as far as the
# kernel is concerned: hid-playstation sets is_edge purely from 0x0DF2 and asks
# for no extra feature reports, then reads four more buttons out of bits 4-7 of
# the same buttons[2] byte and publishes them as BTN_TRIGGER_HAPPY1..4. So the
# pad's own paddles can become real buttons that Steam and games can bind,
# instead of being folded into touchpad halves and stick clicks.
PRODUCT_DUALSENSE = 0x0CE6
PRODUCT_DUALSENSE_EDGE = 0x0DF2
EDGE_FN1, EDGE_FN2 = 0x10, 0x20
EDGE_PADDLE_LEFT, EDGE_PADDLE_RIGHT = 0x40, 0x80


def apply_touch(report, x, y):
    """Mark touch point 0 as a contact at (x, y).

    The DualSense touchpad is one physical button, so "left click" and "right
    click" are not two buttons -- they are the same button with the contact on
    one side or the other, which is how games and Steam tell them apart. Layout
    per the kernel's dualsense_touch_point: contact, x_lo, x_hi:y_lo, y_hi.
    """
    report[TOUCH_POINT_OFFSET] = 0x00                       # active, id 0
    report[TOUCH_POINT_OFFSET + 1] = x & 0xFF
    report[TOUCH_POINT_OFFSET + 2] = ((y & 0x0F) << 4) | ((x >> 8) & 0x0F)
    report[TOUCH_POINT_OFFSET + 3] = (y >> 4) & 0xFF


def apply_paddles(report, state, paddles, targets):
    """Fold the four back paddles into DualSense inputs.

    They are read from the vendor report's byte 7 rather than from evdev, so the
    pad's own profile cannot remap them out from under us. DS mode has nowhere to
    put them natively, hence this: two as touchpad halves, two as stick clicks.
    """
    touch = None
    for pressed, target in zip(paddles, targets):
        if not pressed:
            continue
        if target == "l3":
            report[9] |= ds5.L3
        elif target == "r3":
            report[9] |= ds5.R3
        elif target == "tp-left":
            touch = (TOUCHPAD_W // 4, TOUCHPAD_H // 2)
        elif target == "tp-right":
            touch = (TOUCHPAD_W * 3 // 4, TOUCHPAD_H // 2)
        elif target == "fn1":
            report[10] |= EDGE_FN1
        elif target == "fn2":
            report[10] |= EDGE_FN2
        elif target == "paddle-left":
            report[10] |= EDGE_PADDLE_LEFT
        elif target == "paddle-right":
            report[10] |= EDGE_PADDLE_RIGHT
    if touch:
        report[10] |= ds5.TOUCHPAD
        apply_touch(report, *touch)


# A held rumble level is NOT re-asserted. An earlier version refreshed it every
# half second so that a long effect could not fade out -- and that turned a
# missed stop command into rumble that outlived Steam, the pad being switched
# off, and every reconnect, because the refresh loop had become the only thing
# driving it. A real DualSense holds the level until told otherwise, so
# forwarding each report once is both simpler and correct.
#
# There is no watchdog either, and that was measured rather than assumed: the
# kernel sends a level once and its stop only when the effect ends, so a timeout
# of any length truncates legitimate rumble. A one-second watchdog cut a
# two-second effect in half.
#
# What replaces both is recognising a stop properly -- see is_rumble_stop().


def is_rumble_stop(payload):
    """Is this output report a stop that parse_output cannot see as one?

    A stop normally arrives with the motor validity flags set and both levels at
    zero, which parse_output handles. Steam sends something else: a report with
    *no* validity bits at all and zero motors. Read as "no information" -- which
    is what it literally is -- that leaves the last level standing forever, which
    is how rumble outlived Steam being closed.
    
    Reports that carry other validity bits (lightbar, mic LED) are deliberately
    NOT treated as stops even with zero motor bytes: those are unrelated updates
    that a game can send in the middle of a legitimate long rumble.
    """
    if not payload or payload[0] not in (ds5.DS_OUTPUT_REPORT_USB,
                                         ds5.DS_OUTPUT_REPORT_BT):
        return False
    base = 1 if payload[0] == ds5.DS_OUTPUT_REPORT_USB else 2
    if len(payload) < base + 4:
        return False
    flag0, flag1 = payload[base], payload[base + 1]
    motors = payload[base + 2] or payload[base + 3]
    return not flag0 and not flag1 and not motors


def zero_rumble(link):
    """Silence the motors, best effort -- used on exit and on losing the pad."""
    if link.vendor_fd is None:
        return
    try:
        os.write(link.vendor_fd, legacy.haptic_packet(0, 0))
    except OSError:
        pass


def send_rumble(link, rumble, verbose=False):
    """Forward a DualSense rumble level to the pad's own haptic command.

    The DualSense report carries two 8-bit motor levels and the old dialect's
    haptic command takes exactly that, so this is a straight pass-through. It
    goes to the vendor interface -- the same node the IMU is read from, which is
    why that one is opened read-write.
    """
    if link.vendor_fd is None:
        return
    left, right = rumble
    try:
        os.write(link.vendor_fd, legacy.haptic_packet(left, right))
        if verbose:
            print("rumble -> pad: left %3d right %3d" % (left, right))
    except OSError as exc:
        print("rumble write failed: %s" % exc, file=sys.stderr)
        link.drop("vendor_fd")


def neutral_calibration(blob):
    """The served calibration, with every zero-offset field zeroed.

    The blob is a capture off somebody's real DualSense, and it carries that
    unit's sensor offsets -- including a gyro yaw bias of 10. The kernel throws
    those away (it hard-codes bias 0), but **SDL does not**: it computes
    (value - bias) * sensitivity itself, so a relay that already reports a
    calibrated zero gets 10 subtracted from it and yaw creeps at about 0.6 deg/s
    forever. That is a drift on yaw only, which is exactly what it looks like in
    a game with gyro-to-mouse on.
    
    The scales are what we want to keep, so plus/minus pairs are made symmetric
    about zero at their existing magnitude rather than replaced: sensitivity is
    derived from their span, and calibration_factors() reads it back out of this
    same blob, so both stay in step by construction.
    """
    out = bytearray(blob)

    def s16(i):
        return struct.unpack_from("<h", out, i)[0]

    for i in (0, 2, 4):                      # gyro pitch/yaw/roll bias
        struct.pack_into("<h", out, i, 0)
    for plus_off, minus_off in ((6, 8), (10, 12), (14, 16),        # gyro spans
                                (22, 24), (26, 28), (30, 32)):     # accel spans
        half = (abs(s16(plus_off)) + abs(s16(minus_off))) // 2
        struct.pack_into("<h", out, plus_off, half)
        struct.pack_into("<h", out, minus_off, -half)
    return bytes(out)


class PadLink:
    """The pad, held loosely enough to survive it leaving the USB bus.

    A pad that sleeps or is switched off takes its hidraw and evdev nodes with
    it, and comes back under different node numbers. Opening both once and
    reading them for a session means the relay dies the first time the pad naps
    -- and it takes the virtual DualSense with it, so the game loses the
    controller it was holding. Here the uhid device outlives the pad: readings
    freeze, then resume when the nodes reappear.
    """

    def __init__(self, forced_node=None):
        self.forced_node = forced_node
        self.vendor_fd = None
        self.vendor_node = None
        self.vendor_generation = 0
        self.pad_fd = None
        self.ranges = {}
        self.next_retry = 0.0
        self.warned_no_vendor = False

    def open(self):
        if self.vendor_fd is None:
            node = self.forced_node or legacy.find_vendor_node()
            if node:
                try:
                    # O_RDWR: the same interface carries rumble back to the pad.
                    self.vendor_fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
                    self.vendor_node = node
                    self.vendor_generation += 1
                    print("vendor stream : %s" % node)
                except OSError:
                    self.vendor_fd = None
            elif self.pad_fd is not None and not self.warned_no_vendor:
                # Over Bluetooth the pad is a single HID device with no vendor
                # collection at all, so there is nothing to read the IMU from.
                # Say so once, rather than running as a DualSense whose gyro is
                # permanently dead for no visible reason.
                #
                # Only when the pad itself is present, though: a pad that has
                # simply gone away has no vendor interface either, and blaming
                # Bluetooth for that sent me looking in the wrong place once.
                self.warned_no_vendor = True
                print("no vendor interface -- no gyro or vendor rumble in this "
                      "mode (Bluetooth?); buttons and sticks still work")
        if self.pad_fd is None:
            node, name, fd = padin.find_pad()
            if fd is not None:
                self.pad_fd = fd
                self.ranges = padin.axis_ranges(fd)
                print("gamepad node  : %s (%s)" % (node, name))
                if self.vendor_fd is None and not self.warned_no_vendor:
                    self.warned_no_vendor = True
                    print("no vendor interface -- no gyro or vendor rumble in "
                          "this mode (Bluetooth?); buttons and sticks still work")
                print("axis ranges   : %s" % ", ".join(
                    "%d..%d" % r for r in self.ranges.values()) or "unknown")
        return self.vendor_fd is not None or self.pad_fd is not None

    def fds(self):
        return [fd for fd in (self.vendor_fd, self.pad_fd) if fd is not None]

    def drop(self, which):
        fd = getattr(self, which)
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
            setattr(self, which, None)
            if which == "vendor_fd":
                self.vendor_node = None
            print("%s went away; waiting for it to come back" % which)

    def retry(self, now):
        """Re-open whatever is missing, but not on every loop iteration."""
        if self.vendor_fd is not None and self.pad_fd is not None:
            return
        if now < self.next_retry:
            return
        self.next_retry = now + 1.0
        self.open()


# The pad's face buttons: measured, not assumed. The kernel hands out BTN_NORTH
# and BTN_WEST in the order the descriptor lists its buttons, and this pad lists
# them the other way round -- with the textbook mapping, X produced Triangle and
# Y produced Square. So north is Square here and west is Triangle.
def ds5_buttons(state, pad):
    state.buttons0 = state.buttons1 = state.buttons2 = 0
    state.set(ds5.CROSS, 0, pad.down(padin.BTN_SOUTH))
    state.set(ds5.CIRCLE, 0, pad.down(padin.BTN_EAST))
    state.set(ds5.SQUARE, 0, pad.down(padin.BTN_NORTH))
    state.set(ds5.TRIANGLE, 0, pad.down(padin.BTN_WEST))
    state.set(ds5.L1, 1, pad.down(padin.BTN_TL))
    state.set(ds5.R1, 1, pad.down(padin.BTN_TR))
    state.set(ds5.L2, 1, pad.down(padin.BTN_TL2) or state.l2 > 0)
    state.set(ds5.R2, 1, pad.down(padin.BTN_TR2) or state.r2 > 0)
    state.set(ds5.CREATE, 1, pad.down(padin.BTN_SELECT))
    state.set(ds5.OPTIONS, 1, pad.down(padin.BTN_START))
    state.set(ds5.L3, 1, pad.down(padin.BTN_THUMBL))
    state.set(ds5.R3, 1, pad.down(padin.BTN_THUMBR))
    # PS_HOME is set from the vendor report instead, in the loop: the Home key
    # is a Consumer-page usage on this pad, so it never appears as BTN_MODE.
    state.hat = ds5.hat_from_dpad(pad.abs.get(padin.ABS_HAT0X, 0),
                                  pad.abs.get(padin.ABS_HAT0Y, 0))


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--node", help="vendor hidraw node (default: autodetect)")
    ap.add_argument("--dump", action="store_true", help="print readings, create no device")
    ap.add_argument("--calib", action="store_true", help="show the served calibration's implications")
    ap.add_argument("--rate", type=float, help="DualSense report rate, Hz")
    ap.add_argument("--verbose", action="store_true", help="log output reports (rumble, triggers)")
    ap.add_argument("--hid-debug", action="store_true",
                    help="log full host output and HID handshake results; no writer PID is available")
    ap.add_argument("--quiet-output", action="store_true",
                    help="force bounded logging for a safe live trigger profile")
    ap.add_argument("--emulate", choices=("dualsense", "dualsense-edge"),
                    help="one-run virtual identity override for game compatibility checks")
    adaptive = ap.add_mutually_exclusive_group()
    adaptive.add_argument("--adaptive-triggers", dest="adaptive_triggers",
                          action="store_true", default=None,
                          help="deprecated alias for --trigger-profile ow2-safe")
    adaptive.add_argument("--no-adaptive-triggers", dest="adaptive_triggers",
                          action="store_false",
                          help="disable ForceAdapt translation")
    adaptive.add_argument("--trigger-profile", choices=config.TRIGGER_PROFILES,
                          help="physical trigger profile (default: config file)")
    ap.add_argument("--trigger-debug", action="store_true",
                    help="log decoded and translated trigger effects")
    ap.add_argument("--trigger-dry-run", action="store_true",
                    help="translate and print ForceAdapt packets without writing them")
    ap.add_argument("--trigger-compare-semantic", action="store_true",
                    help="dry-run: compare compatibility and semantic mappings")
    ap.add_argument("--trigger-one-shot-mild-right", action="store_true",
                    help="hardware test: one right mild effect, <=1s, then latch Normal")
    ap.add_argument("--trigger-bounded-mild-right", action="store_true",
                    help="up to three R2 resistance cycles, mild, <=1s each")
    ap.add_argument("--trigger-bounded-native-right", action="store_true",
                    help="one R2 semantic rattle/resistance cycle, <=1s total")
    ap.add_argument("--trigger-bounded-native-session-right", action="store_true",
                    help="up to three R2 semantic cycles, <=4s each/30s total")
    ap.add_argument("--trigger-ow2-safe-right", action="store_true",
                    help="continuous accepted OW2 R2 cycles, <=4s each")
    ap.add_argument("--accel-map", help="pad->DualSense accel axes, e.g. -x,z,y")
    ap.add_argument("--gyro-map", help="pad->DualSense gyro axes, e.g. pitch,yaw,-roll")
    ap.add_argument("--paddles",
                    help="what the pad's M1..M4 labels do, in that label order "
                         "(the labels are not left-to-right); one of %s"
                         % "|".join(PADDLE_TARGETS))
    ap.add_argument("--paddle-bits",
                    help="vendor report bit order for M1..M4, e.g. 2,3,4,5")
    ap.add_argument("--config", help="settings file (default: ~/.config/%s/config.json)"
                                     % config.APP)
    ap.add_argument("--write-config", action="store_true",
                    help="write a default settings file and exit")
    args = ap.parse_args()
    profile_override = (args.adaptive_triggers is not None
                        or args.trigger_profile is not None)

    if (args.trigger_one_shot_mild_right
            and (args.trigger_dry_run or profile_override
                 or args.trigger_bounded_mild_right
                 or args.trigger_bounded_native_right
                 or args.trigger_bounded_native_session_right
                 or args.trigger_ow2_safe_right)):
        ap.error("--trigger-one-shot-mild-right cannot be combined with other trigger modes")
    if (args.trigger_bounded_mild_right
            and (profile_override
                 or args.trigger_bounded_native_right
                 or args.trigger_bounded_native_session_right
                 or args.trigger_ow2_safe_right)):
        ap.error("--trigger-bounded-mild-right cannot be combined with adaptive trigger mode overrides")
    if (args.trigger_bounded_native_right
            and (profile_override
                 or args.trigger_compare_semantic
                 or args.trigger_bounded_native_session_right
                 or args.trigger_ow2_safe_right)):
        ap.error("--trigger-bounded-native-right cannot be combined with other trigger modes")
    if (args.trigger_bounded_native_session_right
            and (profile_override
                 or args.trigger_compare_semantic
                 or args.trigger_ow2_safe_right)):
        ap.error("--trigger-bounded-native-session-right cannot be combined with other trigger modes")
    if (args.trigger_ow2_safe_right
            and (profile_override
                 or args.trigger_compare_semantic)):
        ap.error("--trigger-ow2-safe-right cannot be combined with other trigger modes")
    if args.trigger_compare_semantic and not args.trigger_dry_run:
        ap.error("--trigger-compare-semantic requires --trigger-dry-run")

    # systemd stops services with SIGTERM, whose default action skips `finally`
    # entirely -- so without this the motors keep running after the unit stops.
    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))

    if args.write_config:
        target, written = config.write_default(args.config)
        print("%s %s" % ("wrote" if written else "already exists:", target))
        return 0

    settings, source = config.load(args.config)
    if args.emulate:
        settings["emulate"] = args.emulate
    # Flags win over the file, so anything can be tried without editing it.
    if args.accel_map:
        settings["accel_map"] = args.accel_map
    if args.gyro_map:
        settings["gyro_map"] = args.gyro_map
    if args.paddles:
        settings["paddles"] = [p.strip() for p in args.paddles.split(",")]
    if args.paddle_bits:
        settings["paddle_bits"] = args.paddle_bits
    if args.rate:
        settings["rate_hz"] = args.rate
    if args.verbose:
        settings["verbose"] = True
    if args.trigger_profile is not None:
        settings["trigger_profile"] = args.trigger_profile
    if args.adaptive_triggers is not None:
        settings["trigger_profile"] = (
            "ow2-safe" if args.adaptive_triggers else "disabled")
    ow2_safe_selected = (args.trigger_ow2_safe_right
                         or settings["trigger_profile"] == "ow2-safe")
    diagnostic_override = any((
        args.trigger_one_shot_mild_right, args.trigger_bounded_mild_right,
        args.trigger_bounded_native_right,
        args.trigger_bounded_native_session_right,
        args.trigger_ow2_safe_right))
    generic_selected = (settings["trigger_profile"] == "generic-safe"
                        and not diagnostic_override)
    safe_live_selected = ow2_safe_selected or generic_selected
    if args.quiet_output and not safe_live_selected:
        ap.error("--quiet-output requires a safe trigger profile")
    if (safe_live_selected and not args.trigger_dry_run
            and (args.verbose or args.hid_debug or args.trigger_debug)):
        ap.error("live safe trigger output cannot be combined with debug logging")
    if args.quiet_output or (safe_live_selected and not args.trigger_dry_run):
        settings["verbose"] = False
    verbose = settings["verbose"]
    if source and verbose:
        print("settings      : %s" % source)

    gyro_f, accel_f = calibration_factors()
    accel_map = parse_map(settings["accel_map"], ["x", "y", "z"])
    gyro_map = parse_map(settings["gyro_map"], ["pitch", "yaw", "roll"])
    paddle_bits = parse_paddle_bits(settings["paddle_bits"])
    paddle_targets = list(settings["paddles"])
    if len(paddle_targets) != 4 or any(p not in PADDLE_TARGETS for p in paddle_targets):
        raise SystemExit("paddles needs exactly four of %s, got %r"
                         % ("|".join(PADDLE_TARGETS), paddle_targets))
    edge = settings["emulate"] == "dualsense-edge"
    if settings["emulate"] not in ("dualsense", "dualsense-edge"):
        raise SystemExit("emulate must be dualsense or dualsense-edge, got %r"
                         % settings["emulate"])
    if ((args.trigger_one_shot_mild_right or args.trigger_bounded_mild_right
         or args.trigger_bounded_native_right
         or args.trigger_bounded_native_session_right
         or args.trigger_ow2_safe_right)
            and edge):
        ap.error("bounded trigger tests require --emulate dualsense")
    if (settings["trigger_profile"] == "ow2-safe" and edge):
        ap.error("trigger_profile ow2-safe requires --emulate dualsense")
    # Edge-only targets on a plain DualSense are dropped with a complaint rather
    # than refused: this runs as a daemon, and with the physical pad hidden from
    # SDL a refusal to start leaves the machine with no controller at all. A
    # paddle that does nothing is a smaller problem than that.
    misplaced = [p for p in paddle_targets if p in EDGE_ONLY_TARGETS and not edge]
    if misplaced:
        print("%s only exist on a DualSense Edge; those paddles will do nothing."
              ' Set "emulate": "dualsense-edge" to use them.' % ", ".join(misplaced))
        paddle_targets = ["none" if p in EDGE_ONLY_TARGETS else p
                          for p in paddle_targets]
    if args.calib:
        print("served DualSense calibration implies:")
        for name, f in zip(("pitch", "yaw", "roll"), gyro_f):
            print("  gyro %-5s : %8.3f raw per deg/s" % (name, f))
        for name, (half, bias) in zip(("X", "Y", "Z"), accel_f):
            print("  accel %-4s : %8.1f raw per g, bias %d" % (name, half, bias))
        print("\nApex 4 measured scales:")
        for name, v in legacy.GYRO_DEG_PER_LSB.items():
            print("  gyro %-5s : %.3f deg/s per pad LSB" % (name, v))
        for name, scale, bias in zip("XYZ", legacy.ACCEL_LSB_PER_G, legacy.ACCEL_BIAS):
            print("  accel %-4s: %.1f pad LSB per g, bias %+.1f" % (name, scale, bias))
        print("  gyro signs: %s (the pad's axes are not right-handed w.r.t. its own"
              " accel frame)" % legacy.GYRO_SIGN)
        return 0

    try:
        relay_guard = relay_lock.RelayLock()
    except relay_lock.RelayBusy as exc:
        raise SystemExit(str(exc))

    link = PadLink(args.node)
    if not link.open():
        # Not an error: the relay is built to tolerate an absent pad, so a
        # service that starts before the pad is plugged in -- at boot, or right
        # after installing -- should wait rather than exit and be restarted every
        # couple of seconds by systemd.
        print("no pad yet; waiting for one to appear")

    pad = padin.PadState(link.ranges)
    reading = None
    if args.dump:
        last = 0.0
        while True:
            select.select(link.fds(), [], [], 0.05)
            link.retry(time.monotonic())
            if link.vendor_fd is not None:
                try:
                    while True:
                        data = os.read(link.vendor_fd, 64)
                        if legacy.is_input(data) and legacy.command_echo(data) is None:
                            reading = legacy.Reading(data, paddle_bits=paddle_bits)
                except BlockingIOError:
                    pass
                except OSError:
                    link.drop("vendor_fd")
                    reading = None
                    last_rumble = (0, 0)
            if link.pad_fd is not None:
                try:
                    pad.feed(link.pad_fd)
                except OSError:
                    link.drop("pad_fd")
            now = time.monotonic()
            if reading and now - last > 0.1:
                last = now
                print("gyro %7.1f %7.1f %7.1f deg/s | accel %6.2f %6.2f %6.2f g | "
                      "L2 %3d R2 %3d | paddles %s | sticks %3d,%3d %3d,%3d"
                      % (reading.gyro_deg_s + reading.accel_g +
                         (reading.l2, reading.r2,
                          "".join("1" if p else "0" for p in reading.paddles),
                          pad.abs.get(padin.ABS_X, 128), pad.abs.get(padin.ABS_Y, 128),
                          pad.abs.get(padin.ABS_Z, 128), pad.abs.get(padin.ABS_RZ, 128))))

    # The blobs are stored without their report id; a HID feature read must
    # return it as the first byte, and the kernel checks the length exactly --
    # serving them raw costs one byte and fails probe with "expected 20 got 19".
    features = {num: bytes([num]) + blob
                for num, blob in ds5_usb.FEATURE_REPORTS.items()}
    features[0x05] = bytes([0x05]) + calibration_blob()
    product = PRODUCT_DUALSENSE_EDGE if edge else PRODUCT_DUALSENSE
    name = "Apex 4 (DualSense Edge)" if edge else "Apex 4 (DualSense)"

    def create_device():
        made = uhid.Device(name, ds5_usb.VENDOR_ID, product,
                           ds5_usb.REPORT_DESC, feature_reports=features,
                           trace=print if args.hid_debug else None)
        print("%s created; waiting for the kernel to bind it" % name)
        return made

    # Nothing to present until there is a pad behind it.
    dev = create_device() if link.fds() else None
    close_count = dev.close_count if dev else 0
    drop_after = settings["drop_after_s"]
    absent_since = None if link.fds() else time.monotonic()
    state = ds5.InputState()
    last_rumble = (0, 0)
    period = 1.0 / settings["rate_hz"]
    next_send = time.monotonic()
    t0 = time.monotonic()
    # Dry-run always wins over a configured real-write setting. Trigger debug
    # alone is also read-only unless an accepted profile is selected.
    if args.trigger_one_shot_mild_right:
        safety_gate = trigger_state.OneShotMildGate()
    elif args.trigger_bounded_mild_right:
        safety_gate = trigger_state.BoundedDynamicGate()
    elif args.trigger_bounded_native_right:
        safety_gate = trigger_state.BoundedNativeGate()
    elif args.trigger_bounded_native_session_right:
        safety_gate = trigger_state.BoundedNativeGate(
            duration=4.0, max_cycles=3, session_duration=30.0)
    elif args.trigger_ow2_safe_right:
        safety_gate = trigger_state.Ow2SafeGate()
    elif settings["trigger_profile"] == "ow2-safe":
        safety_gate = trigger_state.Ow2SafeGate()
    elif settings["trigger_profile"] == "generic-safe":
        safety_gate = trigger_state.GenericSafeGate()
    else:
        safety_gate = None
    adaptive_writes = bool(safety_gate is not None and not args.trigger_dry_run)
    trigger_runtime = bool(adaptive_writes or args.trigger_dry_run or args.trigger_debug)
    if isinstance(safety_gate, trigger_state.GenericSafeGate):
        translator = generic_trigger.GenericSafeTranslator()
    elif isinstance(safety_gate, trigger_state.Ow2SafeGate):
        translator = trigger_translation.translate_ow2_safe
    elif (args.trigger_bounded_native_right
          or args.trigger_bounded_native_session_right):
        translator = trigger_translation.translate_semantic
    else:
        translator = trigger_translation.translate
    triggers = trigger_state.TriggerStateManager(
        enabled=trigger_runtime,
        dry_run=args.trigger_dry_run,
        debug=args.trigger_debug,
        reset_timeout=settings["trigger_reset_timeout_s"],
        queue_pending=False,
        effect_filter=safety_gate,
        comparison_translator=(trigger_translation.translate_semantic
                               if args.trigger_compare_semantic else None),
        translator=translator)
    if args.trigger_one_shot_mild_right:
        print("trigger safety test: one R2 mild resistance, <=1.0s, then latched Normal")
    elif args.trigger_bounded_mild_right:
        print("trigger safety test: up to 3 R2 resistance cycles, start>=60, "
              "strength<=40, <=1.0s each, <=30.0s total")
    elif args.trigger_bounded_native_right:
        print("trigger safety test: one R2 native cycle, mode 2 strength<=32 "
              "then mode 1 strength<=40, <=1.0s total")
    elif args.trigger_bounded_native_session_right:
        print("trigger safety test: up to 3 R2 native cycles, mode 2 "
              "strength<=32 then mode 1 strength<=40, <=4.0s each, "
              "<=30.0s total")
    elif args.trigger_ow2_safe_right:
        print("trigger profile: OW2-safe continuous R2 cycles, captured patterns "
              "only, mode 2 strength<=32 then mode 1 strength<=40, "
              "<=4.0s per cycle, Off required to rearm")
    attempted_vendor_generation = None
    verified_vendor_generation = None
    identity_probe = None

    def sync_trigger_transport():
        """Start or cancel an asynchronous, read-only identity probe."""
        nonlocal attempted_vendor_generation, verified_vendor_generation
        nonlocal identity_probe
        current = triggers.transport
        if (current is not None
                and (current.fd != link.vendor_fd
                     or verified_vendor_generation != link.vendor_generation)):
            # The old descriptor is already dead or closed; detach still makes
            # the required best-effort reset attempt and never loops on failure.
            triggers.detach("vendor disconnect")
            verified_vendor_generation = None
        if (identity_probe is not None
                and (link.vendor_fd is None
                     or identity_probe.generation != link.vendor_generation)):
            identity_probe = None
        if not adaptive_writes or link.vendor_fd is None:
            return
        if attempted_vendor_generation == link.vendor_generation:
            return
        attempted_vendor_generation = link.vendor_generation
        triggers.begin_connection()
        if not legacy.is_vendor_node(link.vendor_node):
            print("ForceAdapt refused: node is not 04b4:2412 usage-page 0xFFA0",
                  file=sys.stderr)
            return
        identity_probe = trigger_identity.IdentityProbe(
            link.vendor_generation, time.monotonic())

    def advance_trigger_identity(now):
        """Advance the identity gate without blocking the 250 Hz relay."""
        nonlocal identity_probe, verified_vendor_generation
        nonlocal reading, last_rumble
        if identity_probe is None:
            return
        if (link.vendor_fd is None
                or identity_probe.generation != link.vendor_generation):
            identity_probe = None
            return
        identity_probe.resume_if_due(now)
        timed_out = identity_probe.timeout_result(now)
        if timed_out is not None:
            message, retry_in = timed_out
            if retry_in is None:
                print(message, file=sys.stderr)
                identity_probe = None
            else:
                print("%s; retrying in %.0fs" % (message, retry_in),
                      file=sys.stderr)
            return
        if not identity_probe.request_due(now):
            return
        try:
            packet = legacy.device_info_request()
            written = os.write(link.vendor_fd, packet)
            if written != len(packet):
                raise OSError("short identity request write (%d/%d)"
                              % (written, len(packet)))
            identity_probe.mark_requested(now)
        except OSError as exc:
            print("ForceAdapt identity request failed: %s" % exc,
                  file=sys.stderr)
            triggers.detach("identity request failure")
            verified_vendor_generation = None
            identity_probe = None
            link.drop("vendor_fd")
            reading = None
            last_rumble = (0, 0)

    def accept_trigger_identity(data):
        """Accept an EC response for the current generation, if it is safe."""
        nonlocal identity_probe, verified_vendor_generation
        if identity_probe is None:
            return
        if identity_probe.generation != link.vendor_generation:
            identity_probe = None
            return
        try:
            info = legacy.parse_device_info(data)
            transport = forceadapt.VerifiedTransport.accept_identity(
                link.vendor_fd, link.vendor_node, info)
            if not triggers.attach(transport):
                raise OSError("initial ForceAdapt reset was not written")
            verified_vendor_generation = link.vendor_generation
            identity_probe = None
            print("adaptive triggers: enabled for %s"
                  % forceadapt.identity_description(transport.identity))
        except (forceadapt.IdentityError, ValueError) as exc:
            # Input, motion, paddles and rumble remain useful.  Only ForceAdapt
            # fails closed. Keep probing until the deadline because a normal
            # input frame can coincidentally carry 0xEC in the echo byte.
            identity_probe.mark_rejected(exc)
        except OSError as exc:
            identity_probe = None
            verified_vendor_generation = None
            print("ForceAdapt attach failed: %s" % exc, file=sys.stderr)
            triggers.detach("ForceAdapt attach failure")
            link.drop("vendor_fd")

    def clear_trigger_state(reason, lifecycle=False):
        """Clear both sides, and force a reconnect if a live clear fails."""
        nonlocal identity_probe, verified_vendor_generation
        had_transport = triggers.transport is not None
        cleared = (triggers.reset_lifecycle(reason) if lifecycle
                   else triggers.clear_all(reason, force=True))
        if had_transport and not cleared:
            print("ForceAdapt reset failed; closing vendor transport",
                  file=sys.stderr)
            triggers.detach(reason + " failure")
            identity_probe = None
            verified_vendor_generation = None
            link.drop("vendor_fd")
        return cleared

    sync_trigger_transport()
    advance_trigger_identity(time.monotonic())
    try:
        while True:
            select.select(link.fds() + ([dev.fd] if dev else []), [], [], period)
            now_retry = time.monotonic()
            link.retry(now_retry)
            sync_trigger_transport()
            advance_trigger_identity(now_retry)

            # Take the virtual controller away once the pad has been gone long
            # enough to mean it, and bring it back when the pad returns. Steam
            # and SDL track hotplug perfectly well; what they cannot do is guess
            # that a controller still being offered is not attached to anything.
            if not link.fds():
                if absent_since is None:
                    absent_since = now_retry
                elif dev and drop_after and now_retry - absent_since > drop_after:
                    print("pad absent for %ds -- removing the virtual controller"
                          % drop_after)
                    dev.destroy()
                    dev = None
            else:
                if dev is None:
                    dev = create_device()
                    close_count = dev.close_count
                    state = ds5.InputState()
                    last_rumble = (0, 0)
                absent_since = None
            if link.vendor_fd is not None:
                try:
                    while True:
                        data = os.read(link.vendor_fd, 64)
                        echo = legacy.command_echo(data)
                        if echo == legacy.CMD_GET_DEVICE_INFO:
                            accept_trigger_identity(data)
                            if link.vendor_fd is None:
                                break
                        elif legacy.is_input(data) and echo is None:
                            reading = legacy.Reading(data, paddle_bits=paddle_bits)
                except BlockingIOError:
                    pass
                except OSError:
                    triggers.detach("vendor read failure")
                    verified_vendor_generation = None
                    identity_probe = None
                    link.drop("vendor_fd")
                    reading = None
                    last_rumble = (0, 0)
            if link.pad_fd is not None:
                try:
                    pad.feed(link.pad_fd)
                except OSError:
                    link.drop("pad_fd")

            if dev is None:          # dropped while the pad is away
                continue

            for rtype, payload in dev.poll():
                if rtype != uhid.HID_REPORT_TYPE_OUTPUT:
                    continue
                if not payload:
                    continue
                if verbose:
                    print("output report: %s" % payload.hex(" "))
                out = ds5.parse_output(payload)
                if payload[0] in (ds5.DS_OUTPUT_REPORT_USB,
                                  ds5.DS_OUTPUT_REPORT_BT):
                    triggers.note_output()
                rumble = out["rumble"]
                if rumble is None and is_rumble_stop(payload):
                    rumble = (0, 0)
                if rumble is not None:
                    if rumble != last_rumble:
                        last_rumble = rumble
                        send_rumble(link, rumble, verbose)
                        sync_trigger_transport()
                for effect in out["effects"]:
                    try:
                        triggers.handle(
                            effect, left_motor=last_rumble[0],
                            context={
                                "t": time.monotonic(),
                                "physical_l2": pad.axis(padin.ABS_BRAKE),
                                "physical_r2": pad.axis(padin.ABS_GAS),
                            })
                    except OSError as exc:
                        print("ForceAdapt write failed: %s" % exc, file=sys.stderr)
                        triggers.detach("ForceAdapt write failure")
                        link.drop("vendor_fd")
                if verbose and out["effects"]:
                    print("trigger effects: %s" % out["effects"])

            if dev.close_count != close_count:
                close_count = dev.close_count
                clear_trigger_state("virtual DualSense closed", lifecycle=True)

            now = time.monotonic()
            expired = triggers.expire()
            if expired is False and triggers.transport is not None:
                clear_trigger_state("DualSense output timeout retry")
            if safety_gate is not None:
                safety_expired = safety_gate.expire(triggers)
                if safety_expired is False and triggers.transport is not None:
                    clear_trigger_state("bounded trigger safety timeout retry")
            if now < next_send:
                continue
            next_send = now + period
            if link.pad_fd is None:
                pad = padin.PadState(link.ranges)   # neutral while pad is away
            elif pad.ranges != link.ranges:
                pad = padin.PadState(link.ranges)   # reconnected, maybe otherwise
            state.lx = pad.stick(padin.ABS_X)
            state.ly = pad.stick(padin.ABS_Y)
            state.rx = pad.stick(padin.ABS_Z)
            state.ry = pad.stick(padin.ABS_RZ)
            state.l2 = pad.axis(padin.ABS_BRAKE)
            state.r2 = pad.axis(padin.ABS_GAS)
            ds5_buttons(state, pad)
            if reading:
                state.gyro = [
                    int(round(reading.gyro_deg_s[src] * sign * gyro_f[dst]))
                    for dst, (src, sign) in enumerate(gyro_map)
                ]
                state.accel = [
                    int(round(reading.accel_g[src] * sign * accel_f[dst][0]) + accel_f[dst][1])
                    for dst, (src, sign) in enumerate(accel_map)
                ]
            state.sensor_timestamp = int((now - t0) * 3_000_000) & 0xFFFFFFFF
            report = bytearray(state.pack())
            if reading:
                if reading.home:
                    report[10] |= ds5.PS_HOME
                apply_paddles(report, state, reading.paddles, paddle_targets)
            dev.send_input(bytes(report))
    except KeyboardInterrupt:
        return 0
    finally:
        # The pad holds whatever level it was last given, so a relay that exits
        # without this leaves the motors running with nothing left to stop them.
        triggers.detach("relay shutdown")
        zero_rumble(link)
        if dev:
            dev.destroy()


if __name__ == "__main__":
    sys.exit(main())
